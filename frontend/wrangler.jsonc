{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "time-track-frontend",
  "main": "worker.js",
  "compatibility_date": "2026-10-10",

  // Time Track's own paths only. The root stays the personal site, /time-track/api/*
  // is the Python Worker (a more specific route), and no site-wide path such as /api/*,
  // /_next/* or /vendors/* is claimed: basePath keeps every chunk under /time-track/_next/.
  "workers_dev": false,
  "routes": [
    // One route for /time-track, /time-track?<query> and /time-track/*. Routes match the
    // query string too and a pattern cannot hold one, so an exact `time-track` would miss
    // /time-track?x=1 (it fell through to GitHub Pages' 404). The `*` also catches
    // /time-trackfoo and the like; worker.js passes those to the origin untouched.
    { "pattern": "akshayprabhakant.com/time-track*", "zone_name": "akshayprabhakant.com" }
  ],

  // The Next.js static export (`npm run build`). `run_worker_first` so the prefix is
  // stripped, and tracker URLs mapped to their page, before the assets lookup.
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // The shared site parts (theme and site row): every HTML page goes through site-shell's
  // compose() (akshayDev17/site-themes, shell/). worker.js fails open: with site-shell down,
  // the page is served exactly as built.
  "services": [{ "binding": "SHELL", "service": "site-shell" }]
}
